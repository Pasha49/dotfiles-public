#!/usr/bin/env bash
set -e

# Parse mangowm.toml group definition
{{- $groupConfig := include "dot_config/metapac/groups/mangowm.toml" | fromToml }}

# Populate required packages list from the arch backend section
REQUIRED_PACKAGES=(
{{- if hasKey $groupConfig "arch" }}
{{- range $groupConfig.arch.packages }}
    "{{ . }}"
{{- end }}
{{- end }}
)

echo "==> [chezmoi] Verifying all packages from mangowm.toml (${#REQUIRED_PACKAGES[@]} packages)..."

# Ensure every declared package is installed before proceeding
for pkg in "${REQUIRED_PACKAGES[@]}"; do
    if ! pacman -Qi "$pkg" &> /dev/null; then
        echo "==> [chezmoi] ERROR: Package '$pkg' declared in mangowm.toml is missing."
        echo "==> [chezmoi] Aborting XFCE removal to ensure system stability."
        exit 1
    fi
done

echo "==> [chezmoi] All group packages verified successfully."

# Ensure greetd configuration file exists with Noctalia session wrapper
echo "==> [chezmoi] Ensuring /etc/greetd/config.toml is configured..."
sudo mkdir -p /etc/greetd
sudo tee /etc/greetd/config.toml > /dev/null << 'EOF'
[terminal]
vt = 1

[default_session]
command = "/usr/bin/noctalia-greeter-session"
user = "greeter"
EOF

# Ensure greeter user is in required groups
if id "greeter" &> /dev/null; then
    sudo usermod -aG video,input greeter || true
fi

# Switch display manager in systemd
echo "==> [chezmoi] Switching display manager from LightDM to greetd..."
sudo systemctl disable lightdm 2>/dev/null || true
sudo rm -f /etc/systemd/system/display-manager.service
sudo systemctl enable --force greetd

# Remove XFCE components if present
if pacman -Qq xfce4-session &> /dev/null; then
    echo "==> [chezmoi] Removing XFCE desktop, settings, and LightDM..."
    # Using -Rcns to cascade-remove packages that depend on lightdm/xfce
    sudo pacman -Rcns --noconfirm \
        xfce4 \
        xfce4-goodies \
        lightdm \
        lightdm-gtk-greeter \
        lightdm-gtk-greeter-settings \
        xfce4-notifyd || true
fi

echo "==> [chezmoi] Desktop transition completed successfully!"
